<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Modo escritorio (el móvil conectado a un monitor), tablet y Chromebook: se juega con el
         ratón, así que la pantalla táctil no es obligatoria. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Sockets y descubrimiento NSD para el modo «WiFi local» (dos móviles en la misma red).
         No se usa ningún servidor en internet: los móviles hablan directamente entre ellos. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Vibración corta al acertar y larga al hundir un barco. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".BarquitosApplication"
        android:allowBackup="true"
        android:resizeableActivity="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Barquitos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Barquitos">
            <!-- Tamaño de la ventana en modo escritorio (y en ventana flotante). Cuadrada y alta:
                 lo que se enseña es un tablero. -->
            <layout
                android:defaultWidth="1040dp"
                android:defaultHeight="760dp"
                android:minWidth="360dp"
                android:minHeight="480dp"
                android:gravity="center" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Para compartir el fichero de registro desde el visor. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

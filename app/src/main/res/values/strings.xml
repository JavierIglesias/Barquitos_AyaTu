    <string name="fleet_standard">Estándar</string>
    <string name="fleet_classic">Clásica</string>
    <string name="fleet_russian">Rusa</string>
    <string name="fleet_standard_desc">Seis barcos, dos con forma especial: el portaaviones tiene isla de mando y el submarino torreta. Pueden quedar pegados.</string>
    <string name="fleet_classic_desc">La de toda la vida: cinco barcos rectos de 5, 4, 3, 3 y 2 casillas. Pueden quedar pegados.</string>
    <string name="fleet_russian_desc">Diez barcos (uno de 4, dos de 3, tres de 2 y cuatro de 1) que han de dejar siempre una casilla de separación, también en diagonal.</string>

    <string name="rule_one_shot">Un disparo</string>
    <string name="rule_streak">Racha</string>
    <string name="rule_salvo">Salva</string>
    <string name="rule_chainfire">Fuego en cadena</string>
    <string name="rule_multishot">Multidisparo</string>
    <string name="rule_one_shot_desc">Un disparo por turno, turnos alternos. La regla clásica.</string>
    <string name="rule_streak_desc">Sigues disparando mientras aciertes. El primer fallo acaba tu turno.</string>
    <string name="rule_salvo_desc">Los dos disparáis a la vez, un disparo por cada barco que os quede a flote. Según se hunde tu flota, disparas menos.</string>
    <string name="rule_chainfire_desc">Disparas tantas veces como barcos te queden a flote, pero uno a uno: ves el resultado de cada disparo antes de elegir el siguiente.</string>
    <string name="rule_multishot_desc">Un número fijo de disparos por turno, de 2 a 6, el que elijas al crear la partida.</string>

    <string name="difficulty_easy">Fácil</string>
    <string name="difficulty_normal">Normal</string>
    <string name="difficulty_hard">Difícil</string>
    <string name="difficulty_easy_desc">Dispara casi a ciegas y solo a veces remata lo que ha tocado.</string>
    <string name="difficulty_normal_desc">Busca al tresbolillo y, cuando toca un barco, sigue la línea hasta hundirlo.</string>
    <string name="difficulty_hard_desc">Calcula en cada tirada dónde es más probable que te queden barcos. No hace trampas, pero no perdona.</string>


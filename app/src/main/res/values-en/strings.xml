    <string name="fleet_standard">Standard</string>
    <string name="fleet_classic">Classic</string>
    <string name="fleet_russian">Russian</string>
    <string name="fleet_standard_desc">Six ships, two with a special shape: the carrier has an island and the submarine a conning tower. They may touch each other.</string>
    <string name="fleet_classic_desc">The usual one: five straight ships of 5, 4, 3, 3 and 2 cells. They may touch each other.</string>
    <string name="fleet_russian_desc">Ten ships (one of 4, two of 3, three of 2 and four of 1) that must always keep one cell apart, diagonals included.</string>

    <string name="rule_one_shot">One shot</string>
    <string name="rule_streak">Streak</string>
    <string name="rule_salvo">Salvo</string>
    <string name="rule_chainfire">Chainfire</string>
    <string name="rule_multishot">Multi shot</string>
    <string name="rule_one_shot_desc">One shot per turn, strictly alternating. The classic rule.</string>
    <string name="rule_streak_desc">You keep firing as long as you hit. The first miss ends your turn.</string>
    <string name="rule_salvo_desc">You both fire at the same time, one shot for each ship still afloat. As your fleet sinks, you fire less.</string>
    <string name="rule_chainfire_desc">You fire as many times as you have ships afloat, but one at a time: you see each result before choosing the next target.</string>
    <string name="rule_multishot_desc">A fixed number of shots per turn, from 2 to 6, chosen when the game is created.</string>

    <string name="difficulty_easy">Easy</string>
    <string name="difficulty_normal">Normal</string>
    <string name="difficulty_hard">Hard</string>
    <string name="difficulty_easy_desc">Fires almost blindly and only sometimes finishes off what it hit.</string>
    <string name="difficulty_normal_desc">Searches in a checkerboard pattern and, once it hits, follows the line until the ship sinks.</string>
    <string name="difficulty_hard_desc">Works out on every turn where your remaining ships most likely are. It does not cheat, but it does not forgive either.</string>

